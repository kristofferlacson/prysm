# Copy this file to ".env" and fill it in. The .env file stays on the server:
# it is read by "npm run server" only, is never bundled into the web app, and is ignored by git.

# Key for OpenAI's image API (generative fill, object removal, image generation).
OPENAI_API_KEY=

# Image model to use. Set this to a GPT image model your account can use.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional: an OpenAI-compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com

# Optional server settings.
# PORT=8787
# AI_REQUESTS_PER_MINUTE=12
